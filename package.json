{
  "name": "blackbox-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Локальная утилита разбора и настройки по блэкбоксу Betaflight",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fast": "vitest run --exclude tests/big-dump.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "uplot": "^1.6.32"
  }
}
